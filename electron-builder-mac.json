{
  "appId": "com.irish.machinevision",
  "productName": "Machine Vision By IRiSH",
  "directories": {
    "output": "release-mac"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": false,
  "mac": {
    "category": "public.app-category.education",
    "icon": "build-mac/icon.png",
    "identity": null,
    "hardenedRuntime": false,
    "target": [
      "dmg"
    ],
    "extendInfo": {
      "NSCameraUsageDescription": "Machine Vision ใช้กล้องเพื่อประมวลผลภาพแบบสด (camera is used for live image processing)"
    }
  },
  "dmg": {
    "artifactName": "Machine-Vision-By-IRiSH-${version}-mac-${arch}.${ext}"
  },
  "publish": null,
  "afterPack": ".github/mac/adhoc-sign.cjs"
}
