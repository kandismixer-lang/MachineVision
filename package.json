{
  "name": "machine-vision-app",
  "version": "0.1.6",
  "description": "Machine Vision Desktop App สำหรับการเรียนการสอน (Electron + OpenCV.js)",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "preview": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:dir": "vite build && electron-builder --win --dir",
    "start": "npm run dev"
  },
  "build": {
    "appId": "com.irish.machinevision",
    "productName": "Machine Vision By IRiSH",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "icon": "electron/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Machine Vision"
    },
    "publish": {
      "provider": "github",
      "owner": "kandismixer-lang",
      "repo": "MachineVision"
    }
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@techstark/opencv-js": "^4.10.0-release.1",
    "electron-updater": "^6.8.9",
    "litegraph.js": "^0.7.18",
    "onnxruntime-web": "^1.19.2"
  }
}
